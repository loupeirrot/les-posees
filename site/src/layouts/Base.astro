---
import "@fontsource-variable/archivo/wdth.css";
import "@fontsource-variable/newsreader/wght.css";
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource/atkinson-hyperlegible/400.css";
import "@fontsource/atkinson-hyperlegible/700.css";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import Badge from "../components/Badge.astro";
import photos from "../lib/photos.json";
import { url, latest, frDateTime } from "../lib/data.js";

const { title, description, crumbs = [], image = "og/seignosse-palombe.png", noindex = false, jsonld = [], solidHeader = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(url(image), Astro.site).href;
const path = Astro.url.pathname;
const nav = [
  ["Passage du jour", url(""), ""],
  ["Secteurs", url("secteurs/"), "opt"],
  ["Espèces", url("especes/palombe/"), "opt"],
  ["Méthode", url("methode/"), "opt"],
];
const ld = [
  { "@context": "https://schema.org", "@type": "WebSite", name: "Les posées", url: new URL(url(""), Astro.site).href, inLanguage: "fr-FR" },
  crumbs.length && {
    "@context": "https://schema.org", "@type": "BreadcrumbList",
    itemListElement: [["Accueil", url("")], ...crumbs].map(([name, href], i) => ({ "@type": "ListItem", position: i + 1, name, item: new URL(href, Astro.site).href })),
  },
  ...jsonld,
].filter(Boolean);
const credits = Object.values(Object.values(photos).reduce((acc, p) => {
  const k = p.author + p.license;
  (acc[k] ??= { author: p.author, license: p.license, pages: [] }).pages.push(p.page);
  return acc;
}, {}));
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#121611" />
  <link rel="manifest" href={url("manifest.webmanifest")} />
  <link rel="icon" href={url("icons/icon-192.png")} type="image/png" />
  <link rel="apple-touch-icon" href={url("icons/icon-192.png")} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Les posées" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  {ld.map((x) => <script type="application/ld+json" set:html={JSON.stringify(x)} />)}
  <script is:inline>
    try { const t = localStorage.getItem("theme"); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
</head>
<body data-base={url("")} data-generated={latest.generated_at}>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <header class:list={["site-head band", solidHeader && "solid"]}>
    <div class="wrap head-in">
      <a class="brand" href={url("")} aria-label="Les posées, accueil">
        <Badge size={44} />
        <b>Les posées</b>
      </a>
      <nav class="head-nav" aria-label="Navigation principale">
        {nav.map(([label, href, cls]) => <a class={cls} href={href} aria-current={path === href ? "page" : undefined}>{label}</a>)}
        <button class="dawn" id="theme" type="button" aria-pressed="false" aria-label="Mode aube">
          <Icon name="moon-stars" size={20} />
        </button>
      </nav>
    </div>
  </header>
  <main id="contenu">
    <slot />
  </main>
  <div id="net-banner" class="banner net" role="status" hidden></div>
  <footer class="site-foot band">
    <div class="wrap foot-in">
      <span class="foot-badge"><Badge size={112} /></span>
      <p class="warn">Prévision indicative, non garantie. La dune est fréquentée par les promeneurs et les surfeurs : jamais de tir vers les chemins ni la plage.</p>
      <nav aria-label="Pages du site">
        <a href={url("secteurs/")}>Secteurs</a>
        <a href={url("especes/palombe/")}>Palombe</a>
        <a href={url("especes/grives/")}>Grives</a>
        <a href={url("guides/lire-le-vent/")}>Lire le vent</a>
        <a href={url("methode/")}>Comment on calcule</a>
        <a href={url("etat/")}>État des sources</a>
        <a href={url("archives/")}>Archives</a>
        <a href={url("mentions-legales/")}>Mentions légales</a>
      </nav>
      <p>Données mises à jour le <span class="num">{frDateTime(latest.generated_at)}</span>. Sources : palombe.com et GIFS France, Trektellen, Météo-France (AROME).</p>
      <p class="src">Photos Wikimedia Commons : {credits.map((c, i) => <>{i > 0 && " · "}<a href={c.pages[0]} rel="noopener">{c.author}</a> ({c.license})</>)}.</p>
    </div>
  </footer>
  <script>
    import "../scripts/app.js";
  </script>
</body>
</html>
