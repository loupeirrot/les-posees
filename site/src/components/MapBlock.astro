---
// Carte chargée à la demande (MapLibre + tuiles OpenFreeMap) : secteurs, vent à 8 h, signalements Flash arrondis.
import Icon from "./Icon.astro";
import { latest } from "../lib/data.js";

const payload = {
  sectors: Object.entries(latest.sectors).map(([k, s]) => ({ key: k, ...s })),
  flash: latest.flash.points.map((p) => ({ lat: p.lat, lon: p.lon, direction: p.direction, size: p.size_class, time: p.time })),
  wind: Object.fromEntries(Object.entries(latest.forecast).map(([k, v]) => [k, Object.fromEntries(Object.entries(v.palombe).map(([d, f]) => [d, f ? f.wind.dir : null]))])),
};
---
<section class="band" aria-labelledby="carte">
  <div class="wrap sec" style="padding-top:8px">
    <div class="sec-head">
      <h2 id="carte" class="h-serif">La carte des signalements</h2>
      <p>Les secteurs, le vent à 8 h et les signalements Flash des dernières 24 heures : vert pour l'aller, orange pour le recul.</p>
    </div>
    <div class="map-box" id="map-box" hidden><div id="map"></div></div>
    <button class="btn" id="map-load" type="button"><Icon name="map-trifold" size={22} />Afficher la carte</button>
    <script type="application/json" id="map-data" set:html={JSON.stringify(payload)} />
  </div>
</section>
