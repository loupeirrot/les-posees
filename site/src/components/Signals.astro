---
// Signaux observés : Flash en amont (papier), comptages des cols (bande nuit), observations par département (papier).
import Icon from "./Icon.astro";
import Photo from "./Photo.astro";
import Topo from "./Topo.astro";
import Torn from "./Torn.astro";
import { latest, frTime, frDay, frDateTime, nf, deptName, source } from "../lib/data.js";

const fl = latest.flash;
const up = fl.derive_dernier_signal_amont;
const aller = fl.points.filter((p) => p.direction === "aller").length;
const recul = fl.points.length - aller;
const c = latest.comptages;
const cmp = c?.derive_comparaison;
const total = (d, k) => d?.postes.reduce((a, p) => a + (p[k]?.oiseaux ?? 0), 0);
const obs = latest.observations;
const obsDays = Object.keys(obs.par_jour).sort().reverse();
const srcFlash = source("palombe_flash");
const srcCols = source("palombe_comptages");
---
<section class="band" aria-labelledby="amont">
  <div class="wrap sec split">
    <div class="frame"><Photo name="vol-palombes" alt="Vol de palombes dans un ciel nuageux" sizes="(min-width: 900px) 36rem, 100vw" /></div>
    <div style="display:grid;gap:14px">
      <h2 id="amont" class="h-serif">Dernier signal en amont</h2>
      {up ? (
        <>
          <p class="big-num">{frTime(up.time)}</p>
          <p class="lede">{up.direction === "recul" ? "Vol de recul" : "Vol d'aller"}{up.size_class ? ` de ${up.size_class} palombes` : ""}, à environ {up.derive_distance_km} km au {up.derive_cap_depuis_secteurs} des secteurs.</p>
        </>
      ) : (
        <p class="lede">Aucun signalement Flash au nord des secteurs dans les dernières 24 heures.</p>
      )}
      <div class="facts-line">
        <div><span class="k">Allers, 150 km, 24 h</span><span class="v">{aller}</span></div>
        <div><span class="k">Reculs, 150 km, 24 h</span><span class="v retour">{recul}</span></div>
      </div>
      <p class="src">Source : <a href={srcFlash.url} rel="noopener">Flash migration de palombe.com</a>. Position à 10 km près, sans nom d'observateur ; taille des vols selon les classes de palombe.com.</p>
    </div>
  </div>
</section>

{c && c.J && (
  <section class="band night" aria-labelledby="cols" style="padding-left:0;padding-right:0">
    <Torn color="var(--night)" seed={11} />
    <div class="band" style="position:relative;overflow:hidden">
      <Topo seed={5} />
      <div class="wrap sec cols" style="position:relative">
        <div class="sec-head">
          <h2 id="cols" class="h-serif">Aux cols basques, {frDay(c.J.date)}</h2>
          <p>Arnéguy, Banca, Sare, Urrugne : les comptages du GIFS France, en aval des Landes. Ils confirment un passage, ils ne l'annoncent pas.</p>
        </div>
        <div class="split">
          <div class="facts-line">
            <div><span class="k">Aller, 4 postes</span><span class="big-num">{nf(total(c.J, "aller"))}</span></div>
            <div><span class="k">Retour, 4 postes</span><span class="big-num retour">{nf(total(c.J, "retour"))}</span></div>
          </div>
          <div class="table-wrap">
            <table>
              <thead><tr><th scope="col">Poste</th><th scope="col">Aller</th><th scope="col">Vols</th><th scope="col" class="retour">Retour</th><th scope="col" class="retour">Vols</th></tr></thead>
              <tbody>
                {c.J.postes.map((p) => (
                  <tr><th scope="row">{p.poste}</th><td>{nf(p.aller?.oiseaux)}</td><td>{nf(p.aller?.vols)}</td><td class="retour">{nf(p.retour?.oiseaux)}</td><td class="retour">{nf(p.retour?.vols)}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
        {c.J.note && <p class="quote">« {c.J.note} »</p>}
        {cmp?.moyenne_cumul_aller_a_date && (
          <p>Depuis le début de la saison : <b class="num">{nf(c.cumul_saison_aller_4_postes)}</b> palombes à l'aller, contre <span class="num">{nf(cmp.moyenne_cumul_aller_a_date)}</span> en moyenne à la même date ({cmp.saisons[0]}–{cmp.saisons.at(-1)}){cmp.ecart_cumul_pct !== null ? `, soit ${cmp.ecart_cumul_pct > 0 ? "+" : ""}${cmp.ecart_cumul_pct} %` : ""}.</p>
        )}
        <p class="src">Comptages réalisés par les techniciens des fédérations pour le GIFS France, publiés sur <a href={c.J.url} rel="noopener">palombe.com</a>. Lu le {srcCols.last_ok_at ? frDateTime(srcCols.last_ok_at) : "–"}.</p>
      </div>
    </div>
    <Torn color="var(--paper)" seed={23} flip />
  </section>
)}

<section class="band" aria-labelledby="obs">
  <div class="wrap sec">
    <div class="sec-head">
      <h2 id="obs" class="h-serif">Ce que voient les chasseurs</h2>
      <p>Vols notés dans les observations de palombe.com, par département.</p>
    </div>
    {obsDays.map((d) => {
      const rows = obs.par_jour[d].slice(0, 8);
      const max = Math.max(1, ...rows.map((r) => r.vols));
      return (
        <div style="display:grid;gap:10px">
          <h3 class="h-serif">{frDay(d)}</h3>
          {rows.length === 0 ? <p>Aucune observation publiée pour l'instant.</p> : (
            <div class="bars">
              {rows.map((r) => (
                <div class:list={["bar", r.dept === "40" && "home"]}>
                  <span>{deptName(r.dept)}</span>
                  <i style={`width:${Math.round((100 * r.vols) / max)}%`} aria-hidden="true"></i>
                  <b class="num">{r.vols}</b>
                </div>
              ))}
            </div>
          )}
        </div>
      );
    })}
    <p class="src">Source : <a href={obs.url} rel="noopener">observations de palombe.com</a>, regroupées par département (Landes en orange). Ni nom, ni lieu-dit.</p>
  </div>
</section>
