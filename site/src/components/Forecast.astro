---
// Prévision pour un secteur, une catégorie et un jour. part="verdict" (dans le héros) ou part="details" (sous le héros).
// Tous les blocs sont dans le HTML ; le script n'affiche que celui qui correspond aux choix.
import Icon from "./Icon.astro";
import { latest, frDay, CATEGORIES, source, frDateTime } from "../lib/data.js";

const { sector, cat, day, visible = false, part } = Astro.props;
const f = latest.forecast[sector]?.[cat]?.[day] ?? null;
const name = latest.sectors[sector].name;
const ICON = { good: "check-circle", maybe: "circle-half", low: "x-circle" };
const meteo = source("meteo");
const arrow = (deg) => `rotate(${(deg + 180) % 360} 12 12)`;
const vis = (v) => (v === null || v === undefined ? "–" : v >= 10000 ? "10+" : (v / 1000).toFixed(1).replace(".", ","));
const [w0, w1] = f ? f.window.text.split(" à ") : [];
const fogText = f?.fog
  ? (f.fog.method === "visibilite"
      ? `Visibilité sous 1 km à ${f.fog.hours.map((h) => h + " h").join(", ")} (minimum ${f.fog.min_visibility_m} m). `
      : `Brume probable à ${f.fog.hours.map((h) => h + " h").join(", ")} : air presque saturé (humidité jusqu'à ${f.fog.max_humidity_pct} %). `) +
    (f.fog.clear_at ? `Levée prévue vers ${f.fog.clear_at} h : vols peu visibles avant.` : "Pas de levée prévue avant midi.")
  : null;
const hasVis = f?.hours?.some((h) => h.visibility !== null && h.visibility !== undefined);
const blocked = f?.criteria.some((c) => c.blocking && !c.ok);
// en capitales condensées, « O » se lit comme un zéro : les directions d'une lettre s'écrivent en entier
const dir = (d) => ({ N: "Nord", E: "Est", S: "Sud", O: "Ouest" })[d] ?? d;
---
<div class="fc" data-fc data-sector={sector} data-cat={cat} data-day={day} hidden={!visible}>
  {part === "verdict" && (f ? (
    <section class="verdict" data-level={f.level} aria-label="Verdict du matin">
      <div class="verdict-top">
        <Icon name={ICON[f.level]} size={52} weight="fill" />
        <p class="verdict-word display">{f.word}</p>
      </div>
      <p class="verdict-sub">{CATEGORIES[cat]} · {name} · {frDay(day)}</p>
      <p class="verdict-foot"><b>{f.score} critère{f.score > 1 ? "s" : ""} sur {f.total}{blocked ? " · coup de vent" : ""}</b><span>Indice provisoire, en cours de validation</span></p>
    </section>
  ) : (
    <section class="verdict" data-level="none" aria-label="Verdict du matin">
      <div class="verdict-top">
        <Icon name="circle-dashed" size={52} />
        <p class="verdict-word display">Indisponible</p>
      </div>
      <p class="verdict-sub">{CATEGORIES[cat]} · {name} · {frDay(day)}</p>
      <p class="verdict-foot"><span>La météo n'a pas pu être lue{meteo?.checked_at ? ` (dernier essai le ${frDateTime(meteo.checked_at)})` : ""}. Signalements et comptages restent à jour plus bas.</span></p>
    </section>
  ))}

  {part === "details" && f && (
    <div>
      <div class="keys">
        <div class="key"><span class="k">{f.window.label}</span><span class="v"><span class="nw">{w0}</span><small> à </small><span class="nw">{w1}</span></span></div>
        <div class="key"><span class="k">Lever du soleil</span><span class="v">{f.sunrise}</span></div>
        <div class="key"><span class="k">Vent au sol à 8 h</span><span class="v">{`${dir(f.wind.dir_short)} ${f.wind.speed}`}<small> km/h · {f.wind.force}</small></span></div>
        <div class="key"><span class="k">Vent à 800 m à 8 h</span><span class="v">{f.wind_800 ? <>{`${dir(f.wind_800.dir_short)} ${f.wind_800.speed}`}<small> km/h</small></> : "–"}</span></div>
      </div>
      <div class="reading">
        <p class="lede">{f.reading}</p>
        {fogText && <p class="fog"><Icon name="cloud-fog" size={22} /><span><b>Brume côtière.</b> {fogText}</span></p>}
      </div>
      <details class="fold">
        <summary>Pourquoi ce verdict</summary>
        <div>
          <ul class="crit">
            {f.criteria.map((c) => (
              <li>
                <span class={c.ok ? "ok" : "ko"}><Icon name={c.ok ? "check-circle" : "x-circle"} size={22} /></span>
                <span><b>{c.ok ? "Oui" : "Non"}</b> · {c.label}{c.blocking ? " (bloquant)" : ""}<small>{c.detail}</small></span>
              </li>
            ))}
          </ul>
          <p class="src">Règle simple, écrite à partir du vent, de la pluie et de la brume. Pas encore validée sur le terrain : voir <a href={import.meta.env.BASE_URL + "methode/"}>comment on calcule</a>.</p>
        </div>
      </details>
      <details class="fold hours">
        <summary>Heure par heure</summary>
        <div>
          <div class="table-wrap">
            <table>
              <thead><tr><th scope="col"><span class="sr">Heure</span></th>{f.hours.map((h) => <th scope="col">{h.h}h</th>)}</tr></thead>
              <tbody>
                <tr><th scope="row">Vent sol</th>{f.hours.map((h) => <td>{h.wind_dir === null ? "–" : <><svg class="arrow" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><g transform={arrow(h.wind_dir)}><path d="M12 3v16M6 9l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></g></svg>{Math.round(h.wind_speed)}</>}</td>)}</tr>
                <tr><th scope="row">Rafales</th>{f.hours.map((h) => <td>{h.gusts === null ? "–" : Math.round(h.gusts)}</td>)}</tr>
                <tr><th scope="row">800 m</th>{f.hours.map((h) => <td>{h.wind_dir_800 === null || h.wind_dir_800 === undefined ? "–" : <><svg class="arrow" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><g transform={arrow(h.wind_dir_800)}><path d="M12 3v16M6 9l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></g></svg>{Math.round(h.wind_speed_800)}</>}</td>)}</tr>
                {hasVis
                  ? <tr><th scope="row">Visib. km</th>{f.hours.map((h) => <td class={h.visibility !== null && h.visibility < 1000 ? "mist" : undefined}>{vis(h.visibility)}</td>)}</tr>
                  : <tr><th scope="row">Humidité %</th>{f.hours.map((h) => <td class={h.humidity >= 97 ? "mist" : undefined}>{h.humidity === null || h.humidity === undefined ? "–" : Math.round(h.humidity)}</td>)}</tr>}
                <tr><th scope="row">Pluie mm</th>{f.hours.map((h) => <td class={h.precip >= 0.3 ? "rain" : undefined}>{h.precip === null || h.precip === undefined ? "–" : h.precip.toFixed(1).replace(".", ",")}</td>)}</tr>
                <tr><th scope="row">Nuages bas %</th>{f.hours.map((h) => <td>{h.cloud_low === null || h.cloud_low === undefined ? "–" : Math.round(h.cloud_low)}</td>)}</tr>
              </tbody>
            </table>
          </div>
          <p class="src">Vent en km/h, la flèche montre où il pousse. Modèle AROME de Météo-France, <a href="https://www.data.gouv.fr/datasets/65bd12d7bfd26e26804204cb" rel="noopener">données publiques</a>.</p>
        </div>
      </details>
    </div>
  )}
</div>
