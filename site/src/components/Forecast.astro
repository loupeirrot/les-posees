---
// Bloc de prévision pour un secteur, une catégorie et un jour. Tous les blocs sont rendus en HTML ;
// le script ne fait qu'afficher celui qui correspond aux choix (secteur, gibier, jour).
import Icon from "./Icon.astro";
import { latest, frDay, CATEGORIES, source, frDateTime } from "../lib/data.js";

const { sector, cat, day, visible = false } = Astro.props;
const f = latest.forecast[sector]?.[cat]?.[day] ?? null;
const name = latest.sectors[sector].name;
const ICON = { good: "circle-check", maybe: "contrast", low: "circle-x" };
const meteo = source("meteo");
const arrow = (deg) => `rotate(${(deg + 180) % 360} 12 12)`;
const vis = (v) => (v === null || v === undefined ? "–" : v >= 10000 ? "10+" : (v / 1000).toFixed(1).replace(".", ","));
const fogText = f?.fog
  ? (f.fog.method === "visibilite"
      ? `Visibilité sous 1 km à ${f.fog.hours.map((h) => h + " h").join(", ")} (minimum ${f.fog.min_visibility_m} m). `
      : `Brume probable à ${f.fog.hours.map((h) => h + " h").join(", ")} : air presque saturé (humidité jusqu'à ${f.fog.max_humidity_pct} %). `) +
    (f.fog.clear_at ? `Levée prévue vers ${f.fog.clear_at} h : vols peu visibles avant.` : "Pas de levée prévue avant midi.")
  : null;
const hasVis = f?.hours?.some((h) => h.visibility !== null && h.visibility !== undefined);
---
<div class="fc" data-sector={sector} data-cat={cat} data-day={day} hidden={!visible}>
  {f ? (
    <div style="display:grid;gap:14px">
      <section class="verdict" data-level={f.level} aria-label="Verdict">
        <span class="ico"><Icon name={ICON[f.level]} size={60} /></span>
        <div>
          <p class="verdict-word">{f.word}</p>
          <p class="verdict-sub">{CATEGORIES[cat]} · {name} · {frDay(day)}</p>
        </div>
        <p class="verdict-foot"><b>{f.score} critère{f.score > 1 ? "s" : ""} sur {f.total}{f.criteria.some((c) => c.blocking && !c.ok) ? " · coup de vent" : ""}</b><span>Indice provisoire, en cours de validation</span></p>
      </section>

      <section class="facts" aria-label="L'essentiel">
        <div class="fact"><span class="k">{f.window.label}</span><span class="v"><span class="nw">{f.window.text.split(" à ")[0]}</span><small> à </small><span class="nw">{f.window.text.split(" à ")[1]}</span></span></div>
        <div class="fact"><span class="k">Lever du soleil</span><span class="v">{f.sunrise}</span></div>
        <div class="fact"><span class="k">Vent au sol à 8 h</span><span class="v">{`${f.wind.dir_short} ${f.wind.speed}`}<small> km/h · {f.wind.force}</small></span></div>
        <div class="fact"><span class="k">Vent à 800 m à 8 h</span><span class="v">{f.wind_800 ? <>{`${f.wind_800.dir_short} ${f.wind_800.speed}`}<small> km/h</small></> : "–"}</span></div>
        <div class="fact wide"><span class="k">Ce que ça veut dire</span><p>{f.reading}</p></div>
        {fogText && <div class="fact wide row"><Icon name="cloud-fog" /><div><span class="k">Brume côtière</span><p>{fogText}</p></div></div>}
      </section>

      <details class="card">
        <summary><h2 style="display:inline">Pourquoi ce verdict</h2></summary>
        <ul class="crit">
          {f.criteria.map((c) => (
            <li>
              <span class={c.ok ? "ok" : "ko"}><Icon name={c.ok ? "circle-check" : "circle-x"} size={22} /></span>
              <span><b>{c.ok ? "Oui" : "Non"}</b> · {c.label}{c.blocking ? " (bloquant)" : ""}<small>{c.detail}</small></span>
            </li>
          ))}
        </ul>
        <p class="src">Règle simple, écrite à partir du vent, de la pluie et de la brume. Pas encore validée sur le terrain : voir <a href={import.meta.env.BASE_URL + "methode/"}>comment on calcule</a>.</p>
      </details>

      <details class="card hours">
        <summary><h2 style="display:inline">Heure par heure</h2></summary>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col"><span class="sr">Heure</span></th>{f.hours.map((h) => <th scope="col">{h.h}h</th>)}</tr></thead>
            <tbody>
              <tr><th scope="row">Vent sol</th>{f.hours.map((h) => <td>{h.wind_dir === null ? "–" : <><svg class="arrow" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><g transform={arrow(h.wind_dir)}><path d="M12 3v16M6 9l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></g></svg>{Math.round(h.wind_speed)}</>}</td>)}</tr>
              <tr><th scope="row">Rafales</th>{f.hours.map((h) => <td>{h.gusts === null ? "–" : Math.round(h.gusts)}</td>)}</tr>
              <tr><th scope="row">800 m</th>{f.hours.map((h) => <td>{h.wind_dir_800 === null ? "–" : <><svg class="arrow" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><g transform={arrow(h.wind_dir_800)}><path d="M12 3v16M6 9l6-6 6 6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></g></svg>{Math.round(h.wind_speed_800)}</>}</td>)}</tr>
              {hasVis
                ? <tr><th scope="row">Visib. km</th>{f.hours.map((h) => <td class={h.visibility !== null && h.visibility < 1000 ? "fog" : undefined}>{vis(h.visibility)}</td>)}</tr>
                : <tr><th scope="row">Humidité %</th>{f.hours.map((h) => <td class={h.humidity >= 97 ? "fog" : undefined}>{h.humidity === null || h.humidity === undefined ? "–" : Math.round(h.humidity)}</td>)}</tr>}
              <tr><th scope="row">Pluie mm</th>{f.hours.map((h) => <td class={h.precip >= 0.3 ? "rain" : undefined}>{h.precip === null ? "–" : h.precip.toFixed(1).replace(".", ",")}</td>)}</tr>
              <tr><th scope="row">Nuages bas %</th>{f.hours.map((h) => <td>{h.cloud_low === null || h.cloud_low === undefined ? "–" : Math.round(h.cloud_low)}</td>)}</tr>
            </tbody>
          </table>
        </div>
        <p class="src">Vent en km/h, la flèche montre où il pousse. Modèle AROME de Météo-France, <a href="https://www.data.gouv.fr/datasets/65bd12d7bfd26e26804204cb" rel="noopener">données publiques</a>.</p>
      </details>
    </div>
  ) : (
    <section class="verdict" data-level="none" aria-label="Verdict">
      <span class="ico"><Icon name="circle-dashed" size={60} /></span>
      <div>
        <p class="verdict-word">Prévision indisponible</p>
        <p class="verdict-sub">{CATEGORIES[cat]} · {name} · {frDay(day)}</p>
      </div>
      <p class="verdict-foot"><span>La météo n'a pas pu être lue{meteo?.checked_at ? ` (dernier essai le ${frDateTime(meteo.checked_at)})` : ""}. Les signalements et comptages ci-dessous restent à jour.</span></p>
    </section>
  )}
</div>
