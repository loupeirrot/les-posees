---
// Icône Phosphor (paquet @phosphor-icons/core), insérée en SVG au moment du build.
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";

const { name, size = 22, label, weight = "regular" } = Astro.props;
const require = createRequire(import.meta.url);
const file = require.resolve(`@phosphor-icons/core/assets/${weight}/${name}${weight === "regular" ? "" : "-" + weight}.svg`);
const svg = readFileSync(file, "utf8").replace(
  "<svg ",
  `<svg width="${size}" height="${size}" class="icon" ${label ? `role="img" aria-label="${label}"` : `aria-hidden="true" focusable="false"`} `,
);
---
<Fragment set:html={svg} />
