---
// Icône Lucide (paquet lucide-static), insérée en SVG au moment du build.
import { readFileSync } from "node:fs";
import { createRequire } from "node:module";

const { name, size = 22, label } = Astro.props;
const require = createRequire(import.meta.url);
const file = require.resolve(`lucide-static/icons/${name}.svg`);
let svg = readFileSync(file, "utf8")
  .replace(/<!--.*?-->/gs, "")
  .replace(/width="24"/, `width="${size}"`)
  .replace(/height="24"/, `height="${size}"`)
  .replace("<svg", label ? `<svg role="img" aria-label="${label}"` : `<svg aria-hidden="true" focusable="false"`);
---
<Fragment set:html={svg} />
