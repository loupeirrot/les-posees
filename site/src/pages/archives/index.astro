---
import PageHero from "../../components/PageHero.astro";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import { archives, url, frDay } from "../../lib/data.js";
---
<Base title="Archives des prévisions de passage" description="Chaque matin à 6 h 30, la prévision de chaque secteur est figée. Retrouvez-les jour par jour avec ce qui a été vu." crumbs={[["Archives", url("archives/")]]}>
  <PageHero  crumbs={[["Archives", url("archives/")]]}>Archives</PageHero>
  <div class="band"><div class="prose">
  <p class="lede">La prévision est figée chaque matin à 6 h 30, puis mise en regard de ce qui a été signalé dans la journée.</p>
  {archives.length === 0 ? <p>Aucune journée archivée pour l'instant : la première sera figée demain à 6 h 30.</p> : (
    <div class="list-links">{archives.map((a) => <a href={url(`archives/${a.date}/`)}>{frDay(a.date)}<Icon name="arrow-right" size={28} /></a>)}</div>
  )}
  </div></div>
</Base>
